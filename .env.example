# Copy to .env and edit. Everything here can ALSO be set in Admin → Settings.
PORT=3000
NODE_ENV=production
SESSION_SECRET=change-me-to-a-long-random-string
# Where the database and uploaded images live (keep this folder on a persistent disk)
DATA_DIR=./data
SITE_URL=https://printerspare.com
# Set to 0 only if you run on plain http (no HTTPS) in production
COOKIE_SECURE=1
# First-run admin login (only used when the database is empty)
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=choose-a-strong-password
# Optional secrets (can instead be pasted into Admin → Settings)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
DELHIVERY_TOKEN=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
