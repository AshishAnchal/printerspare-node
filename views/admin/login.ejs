<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex"><title>Admin login · <%= S.store_name %></title><link rel="stylesheet" href="/css/admin.css"></head>
<body><div class="login"><form class="box" method="post" action="/admin/login"><input type="hidden" name="_csrf" value="<%= csrf %>">
<div style="font-size:2.6rem;text-align:center"><%= S.logo_emoji %></div><h1 style="text-align:center;font-size:1.3rem;margin:.3rem 0 1.2rem"><%= S.store_name %> — Admin</h1>
<% if (error) { %><div class="flash error"><%= error %></div><% } %>
<div class="fg"><label>Username or email</label><input class="in" name="username" required autofocus autocomplete="username"></div>
<div class="fg"><label>Password</label><input class="in" type="password" name="password" required autocomplete="current-password"></div>
<button class="btn" style="width:100%;justify-content:center;padding:.7rem">Sign in</button><p class="help" style="text-align:center;margin-top:1rem"><a href="/">← Back to store</a></p></form></div></body></html>
