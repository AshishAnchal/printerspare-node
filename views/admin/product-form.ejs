<%- include('_head') %>
<form method="post" action="/admin/products/save?_csrf=<%= csrf %>" enctype="multipart/form-data">
<input type="hidden" name="id" value="<%= p.id||'' %>">
<div class="toolbar"><a class="btn sec sm" href="/admin/products">← Products</a><div class="sp"></div>
<% if (p.id) { %><a class="btn sec sm" target="_blank" href="/product/<%= p.slug %>">👁 View</a><% } %><button class="btn">💾 Save</button><% if (!p.id) { %><button class="btn sec" name="save_new" value="1">Save & add another</button><% } %></div>
<div class="tabs" data-tabs><button type="button" data-tab="p-basic">Basics</button><button type="button" data-tab="p-price">Price & stock</button><button type="button" data-tab="p-img">Images & video</button><button type="button" data-tab="p-var">Options / variants</button><button type="button" data-tab="p-ship">Badges & shipping</button><button type="button" data-tab="p-seo">SEO</button></div>

<div class="pane" id="p-basic"><div class="card">
 <div class="fg"><label>Product name *</label><input class="in" name="name" required value="<%= p.name||'' %>" placeholder="e.g. HP LaserJet Fuser Unit RM1-6405"></div>
 <div class="row3"><div class="fg"><label>Category *</label><select class="in" name="category_id" required><option value="">Select…</option><% cats.forEach(c => { %><option value="<%= c.id %>" <%= p.category_id==c.id?'selected':'' %>><%= c.name %></option><% }) %></select></div>
 <div class="fg"><label>Brand</label><input class="in" name="brand" list="brandList" value="<%= p.brand||'' %>"><datalist id="brandList"><% brands.forEach(b => { %><option value="<%= b.name %>"><% }) %></datalist></div>
 <div class="fg"><label>SKU / part number</label><input class="in" name="sku" value="<%= p.sku||'' %>"></div></div>
 <div class="fg"><label>Compatible models</label><input class="in" name="compatible_models" value="<%= p.compatible_models||'' %>" placeholder="HP P1606dn, M403, M405…"><small>Customers can search these.</small></div>
 <div class="fg"><label>Description</label><textarea class="in" name="description" rows="6"><%= p.description||'' %></textarea></div>
 <div class="row2"><div class="fg"><label>Search tags</label><input class="in" name="tags" value="<%= p.tags||'' %>" placeholder="fuser, roller, toner"></div><div class="fg"><label>Corner badge</label><input class="in" name="badge" value="<%= p.badge||'' %>" maxlength="20" placeholder="NEW · HOT · LIMITED"></div></div>
 <div style="display:flex;gap:1.6rem;flex-wrap:wrap"><label class="chk"><input type="checkbox" name="is_active" <%= p.is_active?'checked':'' %>> ✅ Active (visible in store)</label><label class="chk"><input type="checkbox" name="is_featured" <%= p.is_featured?'checked':'' %>> ⭐ Featured</label></div></div></div>

<div class="pane" id="p-price"><div class="card"><div class="row3"><div class="fg"><label>Regular price (<%= S.currency %>) *</label><input class="in" type="number" step="0.01" min="0" name="price" value="<%= p.price||'' %>"></div><div class="fg"><label>Sale price</label><input class="in" type="number" step="0.01" min="0" name="sale_price" value="<%= p.sale_price ?? '' %>"><small>Leave empty for no discount.</small></div><div class="fg"><label>Stock</label><input class="in" type="number" min="0" name="stock" value="<%= p.stock ?? 0 %>"><small>Ignored when you add options below (each option has its own stock).</small></div></div></div></div>

<div class="pane" id="p-img"><div class="card"><h2>Main image</h2>
 <img id="mainPrev" class="imgprev" style="<%= p.image?'':'display:none' %>" src="<%= p.image ? '/uploads/'+p.image : '' %>" alt=""><input class="in" type="file" name="image" accept="image/*" data-preview="mainPrev">
 <% if (p.image) { %><label class="chk" style="margin-top:.5rem"><input type="checkbox" name="remove_image"> Remove current image</label><% } %>
 <h3>Extra gallery images</h3><div style="display:flex;gap:.7rem;flex-wrap:wrap;margin-bottom:.6rem"><% gallery.forEach(g => { %><label style="text-align:center;font-size:11px"><img class="thumb" style="width:70px;height:70px" src="/uploads/<%= g.image %>" alt=""><br><input type="checkbox" name="remove_gallery" value="<%= g.id %>"> remove</label><% }) %></div>
 <input class="in" type="file" name="gallery" accept="image/*" multiple><small>Hold Ctrl/Cmd to pick several. JPG, PNG, WebP up to 5 MB each.</small>
 <h3>How-to video</h3><input class="in" name="youtube_url" value="<%= p.youtube_url||'' %>" placeholder="https://www.youtube.com/watch?v=…"><small>Shown in a “How to install” tab.</small></div></div>

<div class="pane" id="p-var"><div class="card"><h2>Options (e.g. 1 piece / 10 pieces)</h2><p class="muted" style="margin-bottom:.7rem">Add options when the same product is sold in different pack sizes or models. Each option has its own price and stock.</p>
 <div class="tbl-wrap"><table class="tbl" id="varTable"><thead><tr><th>Label</th><th>Qty in pack</th><th>Price</th><th>Sale price</th><th>Stock</th><th>Active</th><th></th></tr></thead><tbody>
 <% variants.forEach((v,i) => { %><tr><td><input type="hidden" name="variants[<%= i %>][id]" value="<%= v.id %>"><input class="in" name="variants[<%= i %>][label]" value="<%= v.label %>"></td><td><input class="in" type="number" min="1" name="variants[<%= i %>][qty]" value="<%= v.qty %>"></td><td><input class="in" type="number" step="0.01" name="variants[<%= i %>][price]" value="<%= v.price %>"></td><td><input class="in" type="number" step="0.01" name="variants[<%= i %>][sale_price]" value="<%= v.sale_price ?? '' %>"></td><td><input class="in" type="number" min="0" name="variants[<%= i %>][stock]" value="<%= v.stock %>"></td><td><input type="checkbox" name="variants[<%= i %>][is_active]" value="1" <%= v.is_active?'checked':'' %>></td><td><button type="button" class="btn red sm" onclick="this.closest('tr').remove()">✕</button></td></tr><% }) %></tbody></table></div>
 <button type="button" class="btn sec" id="addVar" style="margin-top:.7rem">➕ Add option</button></div></div>

<div class="pane" id="p-ship"><div class="card"><label class="chk"><input type="checkbox" name="free_shipping" <%= p.free_shipping?'checked':'' %>> 🎁 Free shipping on any order containing this product</label>
 <h3>Feature chips on the product page</h3><div style="display:flex;gap:1.4rem;flex-wrap:wrap"><label class="chk"><input type="checkbox" name="feature_free_shipping" <%= p.feature_free_shipping?'checked':'' %>> 🚚 Free shipping threshold</label><label class="chk"><input type="checkbox" name="feature_returns" <%= p.feature_returns?'checked':'' %>> 🔄 Returns</label><label class="chk"><input type="checkbox" name="feature_genuine" <%= p.feature_genuine?'checked':'' %>> ✅ 100% genuine</label><label class="chk"><input type="checkbox" name="feature_tested" <%= p.feature_tested?'checked':'' %>> 🛡️ Quality tested</label></div></div></div>

<div class="pane" id="p-seo"><div class="card"><div class="fg"><label>URL slug</label><input class="in" name="slug" value="<%= p.slug||'' %>" placeholder="auto-generated from the name"><small>Changing this changes the product link.</small></div><div class="fg"><label>Page title</label><input class="in" name="meta_title" value="<%= p.meta_title||'' %>" maxlength="70"></div><div class="fg"><label>Meta description</label><textarea class="in" name="meta_description" maxlength="170"><%= p.meta_description||'' %></textarea></div></div></div>
</form>
<% if (p.id) { %><form method="post" action="/admin/products/<%= p.id %>/duplicate" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sec sm">⧉ Duplicate</button></form> <form method="post" action="/admin/products/<%= p.id %>/delete" data-confirm="Delete this product permanently?" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn red sm">🗑 Delete product</button></form><% } %>
<script>
(function(){var i=document.querySelectorAll('#varTable tbody tr').length+100;document.getElementById('addVar').onclick=function(){i++;var tr=document.createElement('tr');tr.innerHTML='<td><input class="in" name="variants['+i+'][label]" placeholder="10 Pieces"></td><td><input class="in" type="number" min="1" name="variants['+i+'][qty]" value="1"></td><td><input class="in" type="number" step="0.01" name="variants['+i+'][price]"></td><td><input class="in" type="number" step="0.01" name="variants['+i+'][sale_price]"></td><td><input class="in" type="number" min="0" name="variants['+i+'][stock]" value="10"></td><td><input type="checkbox" name="variants['+i+'][is_active]" value="1" checked></td><td><button type="button" class="btn red sm" onclick="this.closest(\'tr\').remove()">✕</button></td>';document.querySelector('#varTable tbody').appendChild(tr)}})();
</script>
<%- include('_foot') %>
