<%- include('_head') %>
<div class="grid2" style="grid-template-columns:1fr 1fr">
<form class="card" method="post" action="/admin/account/password"><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>🔐 Change my login</h2>
 <div class="row2"><div class="fg"><label>New username (optional)</label><input class="in" name="username"></div><div class="fg"><label>New email (optional)</label><input class="in" type="email" name="email"></div></div>
 <div class="fg"><label>Current password</label><input class="in" type="password" name="current" required autocomplete="current-password"></div>
 <div class="row2"><div class="fg"><label>New password (8+ chars)</label><input class="in" type="password" name="next" required minlength="8" autocomplete="new-password"></div><div class="fg"><label>Repeat</label><input class="in" type="password" name="next2" required autocomplete="new-password"></div></div><button class="btn">Update</button></form>
<div><div class="card"><h2>👥 Admins</h2><% admins.forEach(a => { %><div style="display:flex;gap:.6rem;align-items:center;margin-bottom:.5rem"><div style="flex:1"><b><%= a.username %></b> <%= a.id===me?'(you)':'' %><br><small class="muted"><%= a.email %></small></div><% if (a.id!==me) { %><form method="post" action="/admin/account/<%= a.id %>/delete" data-confirm="Remove this admin?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn red sm">Remove</button></form><% } %></div><% }) %></div>
<form class="card" method="post" action="/admin/account/add"><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>➕ Add admin</h2><div class="row2"><div class="fg"><label>Username</label><input class="in" name="username" required></div><div class="fg"><label>Email</label><input class="in" type="email" name="email" required></div></div><div class="fg"><label>Password (8+ chars)</label><input class="in" type="password" name="password" required minlength="8" autocomplete="new-password"></div><button class="btn">Add admin</button></form></div></div>
<%- include('_foot') %>
