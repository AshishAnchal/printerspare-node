<%- include('../partials/header') %>
<div class="container py-4"><div class="dash"><%- include('../partials/account-nav') %><section>
<h1 style="font-size:1.4rem;font-weight:900;margin-bottom:.4rem">Order <%= o.order_number %> <span class="status <%= o.order_status %>"><%= o.order_status %></span></h1><p class="muted"><%= L.fmtDate(o.created_at) %></p>
<div class="timeline"><% const cur = FLOW.indexOf(o.order_status); FLOW.forEach((st,i) => { %><div class="tl <%= o.order_status==='cancelled'?'':(i<cur?'done':i===cur?'cur':'') %>"><i><%= i<cur?'✓':i+1 %></i><%= st[0].toUpperCase()+st.slice(1) %></div><% }) %></div>
<div class="tbl-wrap"><table class="tbl"><tbody><% items.forEach(i => { %><tr><td><%= i.product_name %></td><td>× <%= i.quantity %></td><td style="text-align:right"><%= L.money(i.total) %></td></tr><% }) %>
<tr><td colspan="2" style="text-align:right">Subtotal</td><td style="text-align:right"><%= L.money(o.subtotal) %></td></tr><% if (o.discount) { %><tr><td colspan="2" style="text-align:right">Discount</td><td style="text-align:right">−<%= L.money(o.discount) %></td></tr><% } %><% if (o.gst) { %><tr><td colspan="2" style="text-align:right">GST</td><td style="text-align:right"><%= L.money(o.gst) %></td></tr><% } %><tr><td colspan="2" style="text-align:right">Shipping</td><td style="text-align:right"><%= o.shipping ? L.money(o.shipping) : 'FREE' %></td></tr><tr><td colspan="2" style="text-align:right"><b>Total</b></td><td style="text-align:right"><b><%= L.money(o.total) %></b></td></tr></tbody></table></div>
<div class="info-grid"><div class="info"><label>Ship to</label><span><%= o.name %>, <%= o.address %>, <%= o.city %>, <%= o.state %> <%= o.pincode %></span></div><% if (o.awb) { %><div class="info"><label>Tracking (<%= o.courier %>)</label><span><%= o.awb %></span></div><% } %></div>
<ul style="border-left:3px solid var(--border);padding-left:1rem;margin:1rem 0"><% events.slice().reverse().forEach(e => { %><li style="margin-bottom:.6rem;font-size:.9rem"><b><%= e.label %></b><br><small class="muted"><%= L.fmtDate(e.created_at) %></small></li><% }) %></ul>
<a class="btn btn-outline" target="_blank" href="/invoice/<%= o.order_number %>">🧾 Invoice</a> <a class="btn btn-navy" href="/track?order=<%= o.order_number %>&contact=<%= encodeURIComponent(o.email) %>">📍 Track</a>
</section></div></div>
<%- include('../partials/footer') %>
