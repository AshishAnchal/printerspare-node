</main>
<% const waNum2 = String(S.whatsapp||'').replace(/\D/g,''); %>
<footer class="footer">
  <div class="container footer-grid">
    <div>
      <h3><%= S.logo_emoji %> <%= S.store_name %></h3>
      <p><%= S.footer_about %></p>
      <p style="margin-top:.8rem">📍 <%= S.address %><br>📞 <a href="tel:<%= S.phone.replace(/[^0-9+]/g,'') %>"><%= S.phone %></a><br>💬 <a href="https://wa.me/<%= waNum2 %>" target="_blank" rel="noopener">WhatsApp</a><br>✉️ <a href="mailto:<%= S.email %>"><%= S.email %></a></p>
      <div class="socials">
        <% [['facebook','f'],['instagram','ig'],['youtube','▶'],['twitter','𝕏']].forEach(([k,i]) => { if (S['social_'+k]) { %><a href="<%= S['social_'+k] %>" target="_blank" rel="noopener" aria-label="<%= k %>"><%= i %></a><% } }) %>
        <a href="https://wa.me/<%= waNum2 %>" target="_blank" rel="noopener" style="background:#25d366" aria-label="WhatsApp">💬</a>
      </div>
    </div>
    <div><h4>Our Categories</h4><ul><% navCats.forEach(c => { %><li><a href="/products?category=<%= c.slug %>"><%= c.name %></a></li><% }) %></ul></div>
    <div><h4>Quick Links</h4><ul>
      <% footerLinks.forEach(m => { %><li><a href="<%= m.url %>"><%= m.label %></a></li><% }) %>
      <% footerPages.forEach(p => { %><li><a href="/page/<%= p.slug %>"><%= p.title %></a></li><% }) %>
    </ul></div>
    <div>
      <% if (S.show_newsletter) { %><h4>Newsletter</h4><p>Subscribe for deals, new parts & offers.</p>
      <form class="newsletter" method="post" action="/subscribe"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="email" name="email" required placeholder="Your email address"><button class="btn btn-yellow btn-sm">Subscribe</button></form><% } %>
      <p style="margin-top:1rem;font-size:.8rem">🕐 <%= S.business_hours %><br><%= S.delivery_note %></p>
    </div>
  </div>
  <div class="footer-bottom"><div class="container">
    <p>&copy; <%= new Date().getFullYear() %> <%= S.store_name %> · <%= S.address %> · <%= S.footer_note %></p>
    <div class="pay-badges"><% if (S.cod_enabled) { %><span class="pay-badge">💵 COD</span><% } %><% if (S.online_enabled) { %><span class="pay-badge">📱 UPI</span><span class="pay-badge">🏦 Netbanking</span><span class="pay-badge">💳 Cards</span><% } %></div>
  </div></div>
</footer>

