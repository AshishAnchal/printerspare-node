<% const bgc = cfg.bg==='light'?'alt':cfg.bg==='dark'?'dark':''; if (sec.cats.length) { %>
<section class="section <%= bgc %>"><div class="container">
  <div class="section-head"><div class="section-title"><%= cfg.heading || 'Top Categories' %></div><a class="section-link" href="/products">View all</a></div>
  <div class="cat-grid"><% sec.cats.forEach(c => { %><a class="cat-card" href="/products?category=<%= c.slug %>"><div class="cat-card-img"><% if (c.image) { %><img src="/uploads/cats/<%= c.image %>" alt="<%= c.name %>" loading="lazy"><% } else { %><svg viewBox="0 0 64 64" width="80" height="80" fill="none" stroke="#cbd5e1" stroke-width="2.5"><rect x="10" y="22" width="44" height="28" rx="4"/><rect x="16" y="8" width="32" height="16" rx="2"/><rect x="18" y="36" width="28" height="10" rx="2"/></svg><% } %></div><div class="cat-card-name"><%= c.name %></div></a><% }) %></div>
</div></section><% } %>
