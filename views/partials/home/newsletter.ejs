<section class="section alt"><div class="container" style="text-align:center;max-width:620px">
  <h2 style="font-size:1.5rem;font-weight:900"><%= cfg.heading %></h2><p class="muted" style="margin:.4rem 0 1rem"><%= cfg.text %></p>
  <form class="newsletter" method="post" action="/subscribe" style="justify-content:center"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="email" name="email" required placeholder="Your email address" style="border:2px solid var(--border);background:var(--bg);color:var(--text)"><button class="btn btn-red">Subscribe</button></form>
</div></section>
