<%- include('../partials/header') %>
<div class="container py-4"><div class="success">
  <div class="tick">✓</div><h1 style="font-size:1.8rem;font-weight:900">Order placed successfully!</h1>
  <p class="muted" style="margin-top:.3rem"><%= S.order_success_message %></p>
  <div class="order-tag">Order #<%= o.order_number %></div>
  <div class="timeline"><% const cur = FLOW.indexOf(o.order_status); FLOW.forEach((st,i) => { %><div class="tl <%= o.order_status==='cancelled'?'':(i<cur?'done':i===cur?'cur':'') %>"><i><%= i<cur?'✓':i+1 %></i><%= st[0].toUpperCase()+st.slice(1) %></div><% }) %></div>
  <div class="info-grid">
    <div class="info"><label>Payment</label><span><%= o.payment_method==='cod' ? 'Cash on Delivery' : 'Online' %> · <span class="status <%= o.payment_status %>"><%= o.payment_status %></span></span></div>
    <div class="info"><label>Total</label><span><%= L.money(o.total) %></span></div>
    <div class="info"><label>Ship to</label><span><%= o.name %>, <%= o.address %>, <%= o.city %>, <%= o.state %> <%= o.pincode %></span></div>
    <div class="info"><label>Confirmation sent to</label><span><%= o.email %></span></div>
  </div>
  <div class="tbl-wrap" style="text-align:left"><table class="tbl"><tbody><% items.forEach(i => { %><tr><td><%= i.product_name %></td><td>× <%= i.quantity %></td><td style="text-align:right"><%= L.money(i.total) %></td></tr><% }) %></tbody></table></div>
  <div style="display:flex;gap:.7rem;justify-content:center;flex-wrap:wrap;margin-top:1.4rem">
    <a class="btn btn-navy" href="/track?order=<%= o.order_number %>&contact=<%= encodeURIComponent(o.email) %>">📍 Track order</a>
    <a class="btn btn-outline" target="_blank" href="/invoice/<%= o.order_number %>">🧾 Print invoice</a>
    <a class="btn btn-whatsapp" target="_blank" rel="noopener" href="<%= storeWa %>">💬 Message us on WhatsApp</a>
    <a class="btn btn-outline" href="/products">Continue shopping</a>
  </div>
</div></div>
<%- include('../partials/footer') %>
