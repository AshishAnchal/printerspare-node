<%- include('../partials/header') %>
<div class="container py-4">
  <h1 style="font-size:1.5rem;font-weight:900;margin-bottom:1rem">🔒 Secure Checkout</h1>
  <div class="steps"><span class="step done">1 Cart</span>›<span class="step on">2 Details & Payment</span>›<span class="step">3 Confirmation</span></div>
  <% errors.forEach(e => { %><div class="alert alert-error inline-alert"><%= e %></div><% }) %>
  <% if (!user && S.guest_checkout) { %><div class="alert alert-info inline-alert" style="font-weight:600">Have an account? <a href="/login" style="text-decoration:underline">Log in</a> for faster checkout and order history.</div><% } %>
  <form method="post" action="/checkout" id="checkoutForm" class="cart-layout" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input type="hidden" name="razorpay_payment_id" id="rzpPay"><input type="hidden" name="razorpay_order_id" id="rzpOrder"><input type="hidden" name="razorpay_signature" id="rzpSig">
    <div>
      <div class="form-card"><h2>📦 Delivery details</h2>
        <div class="form-row"><div class="form-group"><label>Full name *</label><input class="form-input" name="name" required value="<%= form.name %>" autocomplete="name"></div>
          <div class="form-group"><label>Phone *</label><input class="form-input" name="phone" required inputmode="tel" value="<%= form.phone %>" autocomplete="tel"></div></div>
        <div class="form-group"><label>Email *</label><input class="form-input" type="email" name="email" required value="<%= form.email %>" autocomplete="email"></div>
        <div class="form-group"><label>Address *</label><textarea class="form-ta" name="address" rows="2" required style="min-height:70px" autocomplete="street-address"><%= form.address %></textarea></div>
        <div class="form-row"><div class="form-group"><label>Pincode *</label><input class="form-input" name="pincode" id="pincode" required maxlength="6" inputmode="numeric" value="<%= form.pincode %>" autocomplete="postal-code"><small id="pinMsg" class="muted"></small></div>
          <div class="form-group"><label>City *</label><input class="form-input" name="city" id="city" required value="<%= form.city %>" autocomplete="address-level2"></div></div>
        <div class="form-group"><label>State *</label><select class="form-select" name="state" id="state" required><option value="">Select state</option><% Object.values(L.STATES).forEach(s => { %><option <%= form.state===s?'selected':'' %>><%= s %></option><% }) %></select></div>
        <div class="form-group"><label>Order notes (optional)</label><input class="form-input" name="notes" value="<%= form.notes %>" placeholder="e.g. printer model, delivery instructions"></div>
        <% if (S.checkout_note) { %><p class="muted" style="font-size:.85rem"><%= S.checkout_note %></p><% } %>
      </div>
      <div class="form-card"><h2>💳 Payment method</h2>
        <% const codOk = S.cod_enabled; %>
        <label class="pay-opt <%= form.method==='cod'?'sel':'' %> <%= codOk?'':'disabled' %>"><input type="radio" name="payment_method" value="cod" <%= form.method==='cod'?'checked':'' %> <%= codOk?'':'disabled' %>><div><b>💵 Cash on Delivery</b><div class="muted" style="font-size:.84rem">Pay when your parts arrive.<% if (S.cod_fee>0) { %> COD fee <%= L.money0(S.cod_fee) %>.<% } %><% if (S.cod_min_order>0) { %> Orders from <%= L.money0(S.cod_min_order) %>.<% } %><% if (S.cod_max_order>0) { %> Up to <%= L.money0(S.cod_max_order) %>.<% } %></div></div></label>
        <label class="pay-opt <%= form.method==='online'?'sel':'' %> <%= online?'':'disabled' %>"><input type="radio" name="payment_method" value="online" <%= form.method==='online'?'checked':'' %> <%= online?'':'disabled' %>><div><b>📱 Pay online — UPI / Cards / Netbanking</b><div class="muted" style="font-size:.84rem"><%= online ? 'Secure payment via Razorpay.' : 'Not available right now.' %></div></div></label>
      </div>
    </div>
    <aside class="summary"><h2>Your order</h2>
      <% t.items.forEach(i => { %><div style="display:flex;gap:.6rem;margin-bottom:.6rem;font-size:.86rem"><span style="flex:1"><%= i.product.name %><% if (i.label) { %> <small class="muted">(<%= i.label %>)</small><% } %> × <%= i.qty %></span><b><%= L.money(i.line) %></b></div><% }) %>
      <hr style="border:0;border-top:1px solid var(--border);margin:.7rem 0">
      <div class="sline"><span>Subtotal</span><span id="qSub"><%= L.money(t.subtotal) %></span></div>
      <% if (t.discount > 0) { %><div class="sline disc"><span>Coupon <%= t.couponCode %></span><span id="qDisc">−<%= L.money(t.discount) %></span></div><% } %>
      <% if (t.gstMode !== 'none') { %><div class="sline"><span>GST (<%= t.gstPct %>%)<%= t.gstMode==='inclusive'?' incl.':'' %></span><span id="qGst"><%= L.money(t.gst) %></span></div><% } %>
      <div class="sline"><span>Shipping <small class="muted" id="qZone"></small></span><span id="qShip"><%- t.shipping ? L.money(t.shipping) : '<b style="color:var(--success)">FREE</b>' %></span></div>
      <div class="sline" id="qCodRow" style="<%= t.codFee ? '' : 'display:none' %>"><span>COD fee</span><span id="qCod"><%= L.money(t.codFee) %></span></div>
      <div class="sline total"><span>Total</span><span id="qTotal"><%= L.money(t.total) %></span></div>
      <p class="muted" style="font-size:.78rem" id="qDays"></p>
      <button class="btn btn-red btn-xl w-full" id="placeBtn" type="submit" style="margin-top:.7rem">Place Order →</button>
      <p class="muted" style="font-size:.74rem;text-align:center;margin-top:.6rem">🔒 Your details are encrypted & never shared.</p>
    </aside>
  </form>
</div>
<script src="https://checkout.razorpay.com/v1/checkout.js" defer></script>
<script>window.CHECKOUT={cur:<%- JSON.stringify(S.currency) %>,gstMode:<%- JSON.stringify(t.gstMode) %>};</script>
<%- include('../partials/footer') %>
