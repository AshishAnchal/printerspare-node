<%- include('../partials/header') %>
<%
const ep = L.effectivePrice(p), hasV = variants.length > 0;
const v0 = hasV ? variants[0] : null;
const curPrice = hasV ? L.effectivePrice(v0) : ep;
const oldPrice = hasV ? (curPrice < v0.price ? v0.price : null) : (ep < p.price ? p.price : null);
const curStock = hasV ? v0.stock : p.stock;
const waN = String(S.whatsapp).replace(/\D/g,'');
const url = (S.site_url || '') + '/product/' + p.slug;
const chips = [];
if (p.feature_free_shipping && S.free_shipping_above > 0) chips.push(['🚚','Free Shipping ' + L.money0(S.free_shipping_above) + '+']);
if (p.feature_returns) chips.push(['🔄', S.return_days + '-Day Returns']);
if (p.feature_genuine) chips.push(['✅','100% Genuine']);
if (p.feature_tested) chips.push(['🛡️','Quality Tested']);
if (p.free_shipping) chips.unshift(['🎁','Free Shipping on this item']);
%>
<div class="container py-4">
  <nav class="breadcrumb"><a href="/">Home</a>›<a href="/products">Products</a>›<a href="/products?category=<%= p.cat_slug %>"><%= p.cat_name %></a>›<span><%= p.name %></span></nav>
  <div class="pd">
    <div>
      <div class="gallery-main"><% if (gallery.length) { %><img id="mainImg" src="/uploads/<%= gallery[0] %>" alt="<%= p.name %>"><% } else { %><span style="font-size:6rem;opacity:.25">🖨️</span><% } %>
        <% if (oldPrice && S.show_sale_badge) { %><span class="save-badge" style="font-size:.85rem">Save <%= L.discountPct(oldPrice, curPrice) %>%</span><% } %></div>
      <% if (gallery.length > 1) { %><div class="thumbs"><% gallery.forEach((g,i) => { %><button type="button" class="thumb <%= i===0?'active':'' %>" data-src="/uploads/<%= g %>" aria-label="Image <%= i+1 %>"><img src="/uploads/<%= g %>" alt=""></button><% }) %></div><% } %>
    </div>
    <div>
      <span class="pd-brand"><%= p.brand || p.cat_name %></span>
      <h1><%= p.name %></h1>
      <div style="display:flex;align-items:center;gap:.6rem;flex-wrap:wrap">
        <% if (S.show_ratings && p.review_count > 0) { %><%- include('../partials/stars', {rating: p.rating_avg}) %><b style="color:#f59e0b"><%= p.rating_avg %></b><a href="#reviews" class="muted" style="font-size:.85rem">(<%= p.review_count %> review<%= p.review_count>1?'s':'' %>)</a><% } %>
        <% if (p.sku) { %><span class="muted" style="font-size:.8rem">SKU: <%= p.sku %></span><% } %>
      </div>

      <% if (hasV) { %>
      <p style="font-weight:800;margin-top:1rem">Option: <span id="selLabel"><%= v0.label %></span></p>
      <div class="variant-row" id="variantRow"><% variants.forEach((v,i) => { const vp = L.effectivePrice(v), vo = vp < v.price ? v.price : ''; %>
        <button type="button" class="variant <%= i===0?'active':'' %> <%= v.stock<=0?'oos':'' %>" data-id="<%= v.id %>" data-label="<%= v.label %>" data-price="<%= vp %>" data-old="<%= vo %>" data-stock="<%= v.stock %>"><%= v.label %><% if (vo) { %><span class="off"><%= L.discountPct(vo, vp) %>%</span><% } %></button><% }) %></div>
      <% } %>

      <div class="pd-price"><span class="now" id="curPrice"><%= L.money(curPrice) %></span>
        <span class="price-old" id="oldPrice" style="<%= oldPrice ? '' : 'display:none' %>"><%= oldPrice ? L.money(oldPrice) : '' %></span>
        <span class="save-pill" id="savePill" style="<%= oldPrice ? '' : 'display:none' %>"><%= oldPrice ? 'Save ' + L.money(oldPrice - curPrice) : '' %></span></div>
      <p class="muted" style="font-size:.8rem"><%= S.gst_mode==='exclusive' ? 'Exclusive of GST (' + S.gst_percent + '% added at checkout)' : S.gst_mode==='inclusive' ? 'Inclusive of all taxes' : '' %><% if (S.free_shipping_above>0) { %> · Free shipping above <%= L.money0(S.free_shipping_above) %><% } %></p>

      <div id="stockLine" style="font-weight:700;margin:.7rem 0;font-size:.9rem"><%- curStock > 0 ? '<span style="color:var(--success)">✅ In Stock</span>' + (curStock < S.low_stock_threshold ? ' <span class="save-pill" style="background:#fffbeb;color:#92400e">Only ' + curStock + ' left!</span>' : '') : '<span style="color:#ef4444">❌ Out of Stock</span>' %></div>

      <% if (p.compatible_models) { %><div class="compat"><b>🖨️ Compatible with:</b><p style="margin-top:.25rem"><%= p.compatible_models %></p></div><% } %>

      <% if (S.show_pincode_checker) { %><div class="box"><b style="font-size:.9rem">📍 Check delivery</b>
        <div style="display:flex;gap:.5rem;margin-top:.5rem"><input class="form-input" id="pinInput" maxlength="6" inputmode="numeric" placeholder="Enter pincode (e.g. 226010)"><button type="button" class="btn btn-navy" id="pinBtn">Check</button></div>
        <div id="pinResult" style="font-size:.85rem;margin-top:.5rem"></div></div><% } %>

      <form method="post" action="/cart/add" id="addForm">
        <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="product_id" value="<%= p.id %>">
        <input type="hidden" name="variant_id" id="variantId" value="<%= hasV ? v0.id : '' %>">
        <div style="display:flex;align-items:center;gap:.9rem;margin:1rem 0"><b>Quantity</b><div class="qty"><button type="button" data-q="-1">−</button><input type="number" name="qty" id="qtyInput" value="1" min="1" max="<%= Math.max(curStock,1) %>"><button type="button" data-q="1">+</button></div></div>
        <div style="display:flex;gap:.7rem;flex-wrap:wrap">
          <button class="btn btn-red btn-xl" id="addBtn" style="flex:1;min-width:150px" <%= curStock>0?'':'disabled' %>><%= curStock>0 ? S.label_add_to_cart : '❌ Out of Stock' %></button>
          <button class="btn btn-navy btn-xl" id="buyBtn" name="buy_now" value="1" style="flex:1;min-width:150px" <%= curStock>0?'':'disabled' %>><%= S.label_buy_now %></button>
        </div>
      </form>
      <a class="btn btn-whatsapp w-full" style="margin-top:.7rem" target="_blank" rel="noopener" href="https://wa.me/<%= waN %>?text=<%= encodeURIComponent('Hi! I want to order: ' + p.name) %>">💬 Order via WhatsApp</a>
      <% if (chips.length) { %><div class="chips-feat"><% chips.forEach(c => { %><span class="feat"><%= c[0] %> <%= c[1] %></span><% }) %></div><% } %>
      <% if (S.show_share) { %><div style="display:flex;align-items:center;gap:.6rem;margin-top:1.1rem"><span class="muted" style="font-size:.85rem;font-weight:700">Share:</span>
        <a class="pact" style="background:#1877f2;color:#fff" target="_blank" rel="noopener" href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(url) %>">f</a>
        <a class="pact" style="background:#25d366;color:#fff;font-size:.7rem" target="_blank" rel="noopener" href="https://wa.me/?text=<%= encodeURIComponent(p.name + ' - ' + url) %>">wa</a>
        <button class="pact" type="button" id="copyLink" data-url="<%= url || '' %>" title="Copy link">🔗</button></div><% } %>
    </div>
  </div>

  <div class="tabs" id="tabs">
    <button class="tab-btn active" data-tab="t-desc">📄 Description</button><button class="tab-btn" data-tab="t-spec">🔧 Specifications</button>
    <% if (vid) { %><button class="tab-btn" data-tab="t-video">▶️ How to install</button><% } %>
    <button class="tab-btn" data-tab="t-ship">🚚 Shipping</button>
    <% if (S.enable_reviews || reviews.length) { %><button class="tab-btn" data-tab="t-rev" id="revTab">⭐ Reviews (<%= reviews.length %>)</button><% } %>
  </div>
  <div class="tab-pane active" id="t-desc"><p class="muted" style="white-space:pre-line"><%= p.description || 'High quality printer spare part. Tested and verified before shipping.' %></p></div>
  <div class="tab-pane" id="t-spec">
    <table class="tbl" style="max-width:560px"><tbody>
      <% if (p.brand) { %><tr><td><b>Brand</b></td><td><%= p.brand %></td></tr><% } %><% if (p.sku) { %><tr><td><b>SKU</b></td><td><%= p.sku %></td></tr><% } %>
      <tr><td><b>Category</b></td><td><%= p.cat_name %></td></tr>
      <% if (p.compatible_models) { %><tr><td><b>Compatible models</b></td><td><%= p.compatible_models %></td></tr><% } %>
      <% if (p.tags) { %><tr><td><b>Tags</b></td><td><%= p.tags %></td></tr><% } %>
    </tbody></table>
  </div>
  <% if (vid) { %><div class="tab-pane" id="t-video"><div class="video"><iframe src="https://www.youtube-nocookie.com/embed/<%= vid %>?rel=0" loading="lazy" allowfullscreen title="How to install"></iframe></div></div><% } %>
  <div class="tab-pane" id="t-ship"><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1rem">
    <div class="box" style="margin:0"><b>🚚 Delivery</b><p class="muted" style="font-size:.88rem"><%= S.delivery_days_default %> · <%= S.shipping_charge ? L.money0(S.shipping_charge) : 'Free' %><% if (S.free_shipping_above>0) { %> (free above <%= L.money0(S.free_shipping_above) %>)<% } %></p><p class="muted" style="font-size:.85rem;margin-top:.4rem"><%= S.product_shipping_text %></p></div>
    <div class="box" style="margin:0"><b>🔄 Returns</b><p class="muted" style="font-size:.88rem"><%= S.return_days %>-day easy returns · Securely packaged</p></div></div></div>
  <% if (S.enable_reviews || reviews.length) { %>
  <div class="tab-pane" id="t-rev"><div id="reviews">
    <% if (reviews.length) { %><div style="display:flex;gap:2rem;flex-wrap:wrap;align-items:center;margin-bottom:1rem"><div style="text-align:center"><div style="font-size:2.6rem;font-weight:900;line-height:1"><%= p.rating_avg %></div><%- include('../partials/stars', {rating: p.rating_avg}) %><div class="muted" style="font-size:.8rem"><%= reviews.length %> reviews</div></div>
      <div style="flex:1;min-width:220px;max-width:360px"><% dist.forEach(d => { %><div style="display:flex;align-items:center;gap:.5rem;font-size:.78rem"><span style="width:24px"><%= d.n %>★</span><div class="free-bar" style="flex:1"><i style="width:<%= reviews.length ? Math.round(d.c/reviews.length*100) : 0 %>%;background:#f59e0b"></i></div><span style="width:20px"><%= d.c %></span></div><% }) %></div></div>
    <% reviews.forEach(r => { %><div class="review"><b><%= r.name %></b><small><%= L.fmtDay(r.created_at) %></small><div><%- include('../partials/stars', {rating: r.rating}) %></div><p><%= r.comment %></p></div><% }) %>
    <% } else { %><p class="muted">No reviews yet — be the first!</p><% } %>
    <% if (S.enable_reviews) { %><form method="post" action="/product/<%= p.slug %>/review" class="form-card" style="margin-top:1.4rem;max-width:560px"><h2>Write a review</h2><input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="rate-input"><% [5,4,3,2,1].forEach(n => { %><input type="radio" id="rt<%= n %>" name="rating" value="<%= n %>" <%= n===5?'checked':'' %>><label for="rt<%= n %>">★</label><% }) %></div>
      <div class="form-group"><label>Your name</label><input class="form-input" name="name" required maxlength="80" value="<%= user ? user.name : '' %>"></div>
      <div class="form-group"><label>Review</label><textarea class="form-ta" name="comment" required maxlength="1000"></textarea></div><button class="btn btn-navy">Submit review</button></form><% } %>
  </div></div><% } %>

  <% if (related.length) { %><div style="margin-top:3rem"><div class="section-head"><div class="section-title">Related Products</div><a class="section-link" href="/products?category=<%= p.cat_slug %>">View all</a></div>
    <div class="products-grid"><% related.forEach(x => { %><%- include('../partials/product-card', {p: x}) %><% }) %></div></div><% } %>
</div>
<script type="application/ld+json"><%- JSON.stringify({'@context':'https://schema.org','@type':'Product',name:p.name,image: p.image ? [(S.site_url||'') + '/uploads/' + p.image] : undefined,description:p.description||p.name,sku:p.sku||undefined,brand:p.brand?{'@type':'Brand',name:p.brand}:undefined,aggregateRating:(p.review_count>0)?{'@type':'AggregateRating',ratingValue:p.rating_avg,reviewCount:p.review_count}:undefined,offers:{'@type':'Offer',priceCurrency:'INR',price:curPrice,availability:curStock>0?'https://schema.org/InStock':'https://schema.org/OutOfStock',url}}).replace(/</g,'\\u003c') %></script>
<script>window.PRODUCT={cur:<%- JSON.stringify(S.currency) %>,lowStock:<%= S.low_stock_threshold %>,addLabel:<%- JSON.stringify(S.label_add_to_cart) %>};</script>
<%- include('../partials/footer') %>
